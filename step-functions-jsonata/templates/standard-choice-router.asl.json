{
  "QueryLanguage": "JSONata",
  "Comment": "Choice router: route input based on JSONata Condition expressions. Default is required to avoid States.NoChoiceMatched at runtime. In JSONata mode the only Choice rule fields are Condition, Next, and optionally Output/Assign/Comment.",
  "StartAt": "RouteByType",
  "States": {
    "RouteByType": {
      "Type": "Choice",
      "Choices": [
        {
          "Comment": "High-priority items go to the fast path.",
          "Condition": "{% $states.input.priority = 'high' and $states.input.amount > 0 %}",
          "Next": "FastPath"
        },
        {
          "Comment": "Refunds branch to the refund flow.",
          "Condition": "{% $states.input.type in ['refund', 'chargeback'] %}",
          "Next": "RefundPath"
        },
        {
          "Comment": "Numeric age threshold.",
          "Condition": "{% $states.input.ageSeconds > 86400 %}",
          "Next": "StalePath"
        }
      ],
      "Default": "NormalPath"
    },

    "FastPath": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${FastPathFnArn}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException", "Lambda.ServiceException",
                          "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 1, "MaxAttempts": 4, "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "TimeoutSeconds": 15,
      "Output": "{% $states.result.Payload %}",
      "End": true
    },

    "RefundPath": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${RefundFnArn}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException", "Lambda.ServiceException",
                          "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2, "MaxAttempts": 6, "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "TimeoutSeconds": 60,
      "Output": "{% $states.result.Payload %}",
      "End": true
    },

    "StalePath": {
      "Type": "Succeed",
      "Comment": "Item is too old to process — record and exit.",
      "Output": "{% { 'status': 'stale', 'input': $states.input } %}"
    },

    "NormalPath": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${NormalPathFnArn}",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException", "Lambda.ServiceException",
                          "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2, "MaxAttempts": 6, "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "TimeoutSeconds": 60,
      "Output": "{% $states.result.Payload %}",
      "End": true
    }
  }
}
